# =============================================================================
# Single project-root environment file
# Copy this file to .env in the same folder (next to app.py) and fill in values.
# Never commit .env. Streamlit and FastAPI load .env automatically via python-dotenv
# (see frontend/app.py / backend/api_server.py) — there is no separate "activate" step in Python.
#
# For Streamlit Community Cloud: paste the same KEY=value pairs into
# App settings → Secrets (TOML format; same names as below).
# =============================================================================

# ---------------------------------------------------------------------------
# Zero-cost / self-hosted LLM (priority over all cloud keys when URL is set)
# Run: `ollama serve` then `ollama pull llama3.2` (or mistral, etc.)
# LiteLLM: point LOCAL_LLM_URL at your proxy (e.g. http://127.0.0.1:4000/v1) — same OpenAI shape.
# ---------------------------------------------------------------------------
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_MODEL=llama3.2
# (aliases) OLLAMA_BASE_URL= / OLLAMA_API_KEY= / OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible) — required for AI signal validation, Forecast Lab, alerts
# The app also accepts the same values under OPENAI_* or CURSOR_* names; set one key + base + model.
#
# --- Google AI Studio (Gemini) ---
# Get a key at https://aistudio.google.com — any ONE of the key env names below is enough.
# If your key starts with AIza and you omit AI_BASE_URL, the app uses Gemini’s OpenAI-compatible
# endpoint automatically (works with signal validation + API proxy).
#
# GEMINI_API_KEY=
# (or) GOOGLE_AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
#
# --- OpenAI / others ---
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# xAI: leave AI_MODEL unset to use grok-2-latest, or set a model from your xAI console.
# OpenAI: leave unset for gpt-4o-mini, or set e.g. gpt-4o, gpt-4o-mini.
# AI_MODEL=gpt-4o-mini
# XAI: use AI_BASE_URL=https://api.x.ai/v1 and a valid Grok model in AI_MODEL (or set XAI_API_KEY instead of AI_API_KEY)

# ---------------------------------------------------------------------------
# LLM failover (Groq / second OpenAI-compatible host) — optional
# Used automatically by signal validation, Forecast Lab, `/v1/chat/completions`, and NLP alerts
# when the primary provider errors out.
# ---------------------------------------------------------------------------
# AI_FAILOVER_API_KEY=
# AI_FAILOVER_BASE_URL=https://api.groq.com/openai/v1
# AI_FAILOVER_MODEL=llama-3.1-8b-instant
# (aliases) GROQ_API_KEY= / GROQ_BASE_URL= / GROQ_MODEL=

# ---------------------------------------------------------------------------
# Coolio forecast engine + LLM reasoning (optional analyst briefing)
# ---------------------------------------------------------------------------
# EPFORECAST_SIGNAL_FORECAST_ENGINE=coolio
# After a Coolio ensemble run, an LLM can add a "Coolio briefing" (same credentials as AI_*).
# 0 = numbers only from sklearn. 1 = call LLM when a key or LOCAL_LLM_URL is set.
# EPFORECAST_COOLIO_LLM=1
# Override model for this call only (e.g. your strongest / Opus-class id via OpenRouter or provider)
# EPFORECAST_COOLIO_LLM_MODEL=
# EPFORECAST_COOLIO_LLM_MAX_TOKENS=1400
# Set 0 / unlimited / omit to leave max output tokens to the provider (no app-side cap).
# EPFORECAST_COOLIO_LLM_TIMEOUT_SEC=90
#
# Sidebar “Coolio · commands”: maps free-form text → allow-listed actions via LLM when AI_* is set.
# 0 / false = phrase patterns only. Default on when credentials exist.
# EPFORECAST_COOLIO_COMMANDS_LLM=1
# EPFORECAST_COOLIO_COMMAND_LLM_MAX_TOKENS=256
# EPFORECAST_COOLIO_COMMAND_LLM_TIMEOUT_SEC=45
# EPFORECAST_COOLIO_COMMAND_LLM_MODEL=
#
# Coolio signal lens (dashboard): counts validator-approved rows in signals.db by source tier;
# surfaces official-feed (WHO/CDC/UN/PAHO/CIDRAP/ReliefWeb) items. On when EPFORECAST_SIGNAL_FORECAST_ENGINE=coolio,
# or set EPFORECAST_COOLIO_SIGNAL_LENS=1 with any engine.
# EPFORECAST_COOLIO_SIGNAL_LENS=1
# EPFORECAST_COOLIO_LENS_HOURS=72
# EPFORECAST_COOLIO_LENS_LIMIT=150
#
# Coolio forecast training subset: empty = all approved signals. "official" = agency feeds only (often sparse).
# EPFORECAST_COOLIO_FORECAST_SOURCE_TIER=
# EPFORECAST_COOLIO_FORECAST_SOURCE_TIER=official
# EPFORECAST_COOLIO_FORECAST_SOURCE_TIER=official_open_web
#
# Coolio ML vs world briefing:
# 1 = train RF+HGB on local validated signals when enough history (default).
# 0 = skip sklearn; use only open-web context briefing (+ LLM if configured).
# EPFORECAST_COOLIO_ML=1
#
# When local history is empty or below Coolio minimum, fall back to world briefing (1 = on).
# EPFORECAST_COOLIO_WORLD_FALLBACK=1
# EPFORECAST_COOLIO_WORLD_LLM_TIMEOUT_SEC=100
# EPFORECAST_COOLIO_WORLD_LLM_MAX_TOKENS=1800
# 0 / unlimited / omit = provider default max output (no app-side cap).
#
# Coolio memory: append short world-briefing summaries to data/coolio_memory/ for later prompts (RAG-style).
# EPFORECAST_COOLIO_MEMORY=1
# EPFORECAST_COOLIO_MEMORY_MAX_BYTES=2000000

# ---------------------------------------------------------------------------
# Live validated signals — SQLite (path relative to project root, or absolute)
# ---------------------------------------------------------------------------
# SIGNAL_DB_PATH=data/signals.db

# ---------------------------------------------------------------------------
# Optional: how hard the signal validator works (defaults are fine for most use)
# ---------------------------------------------------------------------------
# SIGNAL_VALIDATOR_MAX_LLM_CALLS=30
# SIGNAL_VALIDATOR_CACHE_TTL_SEC=86400
# SIGNAL_VALIDATOR_LLM_TIMEOUT=11.0
# SIGNAL_VALIDATOR_BATCH_SIZE=10
# SIGNAL_VALIDATOR_MAX_PENDING_ITEMS=120
# SIGNAL_VALIDATOR_DISABLE_LLM=0

# ---------------------------------------------------------------------------
# Optional API protection (FastAPI server)
# 0 disables the rate limit; /health is never limited.
# ---------------------------------------------------------------------------
# API_RATE_LIMIT_PER_MIN=120
# For tighter budget control on small deployments, consider:
# API_RATE_LIMIT_PER_MIN=80
# SIGNAL_VALIDATOR_MAX_PENDING_ITEMS=60
#
# Browser CORS origins (comma-separated). Set when the UI is on Vercel / another host.
# Example: https://your-app.vercel.app,http://localhost:3000
# API_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Streamlit → FastAPI NLP alerts (if you run the API server)
# ---------------------------------------------------------------------------
# ALERTS_API_URL=http://127.0.0.1:8000/v1/nlp-alerts

# ---------------------------------------------------------------------------
# Optional news / media volume
# ---------------------------------------------------------------------------
# NEWSAPI_KEY=
# (alias) NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Optional: social / enterprise feeds (connectors in admin checks)
# ---------------------------------------------------------------------------
# X_API_BEARER=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_ORG_ID=
# META_ACCESS_TOKEN=
# META_PAGE_ID=

# ---------------------------------------------------------------------------
# Admin: email — SendGrid (transactional) or generic SMTP
# With SENDGRID_API_KEY alone, the app defaults to smtp.sendgrid.net and user "apikey".
# ---------------------------------------------------------------------------
# SENDGRID_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_USE_TLS=1
# ALERT_FROM_EMAIL=your-email@example.com

# ---------------------------------------------------------------------------
# Year‑1 operations stack (optional hints for Admin “budget alignment” panel + runbooks)
# Domain: register PathogenEconomyEpiforecast.com (or your chosen hostname) at Cloudflare.
# ---------------------------------------------------------------------------
# PUBLIC_SITE_DOMAIN=pathogeneconomyepiforecast.com
# CLOUDFLARE_ZONE_ID=
# BETTER_STACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/...
# UPTIME_HEARTBEAT_URL=
# Cloudflare R2 (S3-compatible) — for off-site SQLite / upload backups
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# ABQ app builder trial — set when embedding ABQ-managed surfaces
# ABQ_PROJECT_ID=

# ---------------------------------------------------------------------------
# No AI / no external feed mode (deterministic + local DB only options)
# ---------------------------------------------------------------------------
# EPFORECAST_NO_AI=1 — disable all LLM usage: NLP-style alerts = threshold rules;
# Forecast Lab four-disease brief = heuristic indices from dashboard KPIs; signal
# validator = keyword-only (same as SIGNAL_VALIDATOR_DISABLE_LLM). SEIR + sklearn
# RF (when enough history) still run locally with no API keys.
# EPFORECAST_OFFLINE_SNAPSHOT=1 — skip GDELT/WHO/Reddit/… HTTP entirely; snapshot
# zeros out live totals but still reads validated counts from `signals.db`. Pair
# with EPFORECAST_NO_AI for a fully local lab machine.
#
# EPFORECAST_FEED_DEADLINE_SEC — cold-start network deadline in seconds for the
# parallel feed fan-out (GDELT/WHO/CDC/Reddit/HN/…). Default 7. Lower for snappier
# first paint (slow feeds simply degrade). Range clamped to 3–20.
# EPFORECAST_FEED_DEADLINE_SEC=7

# ---------------------------------------------------------------------------
# Public feeds (GDELT, OWID, Reddit, HN) use no API keys
# ---------------------------------------------------------------------------
