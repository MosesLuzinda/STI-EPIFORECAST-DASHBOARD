# Copy to .env and fill in values. Never commit real .env files.

# ---------------------------------------------------------------------------
# LLM (OpenAI-compatible) — used by FastAPI (api_server.py) + Streamlit
# "CURSOR_*" is just a naming alias: Cursor IDE has no official public chat API.
# Point BASE_URL at OpenAI, Groq, OpenRouter, xAI, etc.
# ---------------------------------------------------------------------------
# CURSOR_API_KEY=
# CURSOR_API_BASE_URL=https://api.openai.com/v1
# CURSOR_AI_MODEL=gpt-4o-mini

# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# XAI_API_KEY=
# Example xAI base: https://api.x.ai/v1

# ---------------------------------------------------------------------------
# Streamlit → FastAPI for NLP alerts (optional; defaults to localhost)
# ---------------------------------------------------------------------------
# ALERTS_API_URL=http://127.0.0.1:8000/v1/nlp-alerts

# ---------------------------------------------------------------------------
# Optional news volume (used by data_services.fetch_realtime_outbreak_data)
# ---------------------------------------------------------------------------
# NEWSAPI_KEY=
# Sign up: https://newsapi.org/

# ---------------------------------------------------------------------------
# Admin risk email delivery (daily + emergency alerts)
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_USE_TLS=1
# ALERT_FROM_EMAIL=your-email@example.com

# ---------------------------------------------------------------------------
# Public APIs already used without keys (see GET /v1/catalog/public-apis)
# ---------------------------------------------------------------------------
# GDELT, OWID CSV, Reddit JSON search, Hacker News Algolia — no env vars.
