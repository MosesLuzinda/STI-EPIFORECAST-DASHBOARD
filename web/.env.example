# Used by Next.js (server) for the /health check on the home page.
# On Vercel: Project → Settings → Environment Variables → API_URL = https://your-api.host
# For browser-side fetch later, also set NEXT_PUBLIC_API_URL to the same origin.
API_URL=http://127.0.0.1:8000

# Public URL of the live Streamlit dashboard (hosted on Streamlit Community
# Cloud / Render / Fly / Hugging Face Spaces — Vercel cannot run Streamlit).
# When set, the Vercel landing page shows an "Open live dashboard" button.
NEXT_PUBLIC_DASHBOARD_URL=

# Optional: human-readable tagline / build label rendered on the landing page.
NEXT_PUBLIC_SITE_TAGLINE=Epidemic intelligence + forecasts
